{
  "name": "full-stack-open-phonebook-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "build": "npm --prefix frontend ci && npm --prefix frontend run build && node scripts/copy-frontend.js",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "demo": "node scripts/local-demo.js"
  },
  "engines": {
    "node": ">=22.3.0"
  },
  "dependencies": {
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "mongoose": "9.11.2",
    "morgan": "1.12.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.1"
  }
}
